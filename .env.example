# Backend Rust (Axum) — default http://127.0.0.1:8080
PORT=8080

# Data besar (video, hasil, jobs) ditaruh di drive Data, bukan SSD OS.
# Kalau path ini tidak tersedia, backend otomatis fallback ke .data
DATA_DIR=/run/media/rezal/Data/vidboost

# ffmpeg / ffprobe (kosong = pakai yang ada di PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Font untuk drawtext (opsional; backend akan cari font sistem dulu)
# DRAWTEXT_FONTFILE=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# AI upscaler lokal (FSRCNN CPU). Jalankan scripts/setup-fsrcnn.sh dulu.
# AI_UPSCALER_BIN=$PWD/scripts/fsrcnn-upscaler.sh
# FSRCNN_MODEL_DIR=$HOME/vidboost-ai/fsrcnn

# Pengaman CPU/RAM — sesuaikan jumlah vCPU
FFMPEG_THREADS=2
FSRCNN_THREADS=2
MAX_OUTPUT_PIXELS=5000000
